theme = "light:Material,dark:Material Darker"

font-family = "JetBrainsMono Nerd Font Mono"
font-thicken = true

adjust-cell-height = "2%"

window-width = 120
window-height = 28
window-padding-x = 10
window-padding-y = 0

window-colorspace = "display-p3"

cursor-style = "block"
shell-integration-features = "no-cursor"

confirm-close-surface = false
quit-after-last-window-closed = true
quit-after-last-window-closed-delay = "1h"

clipboard-paste-protection = false

notify-on-command-finish = "unfocused"
notify-on-command-finish-action = "bell,notify"
notify-on-command-finish-after = 1s

bell-features = "system,attention,no-title,border"

initial-command = zsh -lc 'fastfetch; exec zsh -l'
