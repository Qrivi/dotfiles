# How often Homebrew checks for updates, in seconds.
HOMEBREW_AUTO_UPDATE_SECS=86400 # 24 hours

# Hide Homebrew's environment-variable hint messages.
HOMEBREW_NO_ENV_HINTS=1

# Don't quit/relaunch running cask applications during `brew upgrade`.
# Avoids apps inheriting Homebrew's environment when they are relaunched.
HOMEBREW_NO_UPGRADE_QUIT_CASKS=1
