                    },
                    "comment.doc": {
                        "color": "#545454",
                        "font_style": "italic"
                    },
                    "constant": {
                        "color": "#89DDFF"
                    },
                    "constructor": {
                        "color": "#FFCB6B"
                    },
                    "embedded": {
                        "color": "#EEFFFF"
                    },
                    "function": {
