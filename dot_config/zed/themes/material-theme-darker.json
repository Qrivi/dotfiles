                    },
                    "number": {
                        "color": "#F78C6C"
                    },
                    "operator": {
                        "color": "#89DDFF"
                    },
                    "property": {
                        "color": "#f07178"
                    },
                    "punctuation": {
                        "color": "#89DDFF"
                    },
                    "punctuation.bracket": {
                        "color": "#89DDFF"
                    },
                    "punctuation.delimiter": {
                        "color": "#89DDFF"
                    },
                    "punctuation.special": {
                        "color": "#EEFFFF"
                    },
                    "string": {
                        "color": "#C3E88D"
                    },
                    "string.escape": {
                        "color": "#EEFFFF"
                    },
                    "string.regex": {
                        "color": "#89DDFF"
                    },
                    "type": {
                        "color": "#FFCB6B"
                    },
                    "variable": {
                        "color": "#EEFFFF"
                    },
                    "variable.special": {
                        "color": "#f07178",
