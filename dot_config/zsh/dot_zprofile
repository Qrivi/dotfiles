# ~/.config/zsh/.zprofile

# --- Homebrew ---

[[ -x "$HOMEBREW_PREFIX/bin/brew" ]] && \
  eval "$("$HOMEBREW_PREFIX/bin/brew" shellenv)"

# --- OrbStack ---

[[ -f "$HOME/.orbstack/shell/init.zsh" ]] && \
  source "$HOME/.orbstack/shell/init.zsh"

# --- Ruby ---

RUBY_DIR="$HOMEBREW_PREFIX/opt/ruby"
[[ -x "$RUBY_DIR/bin/ruby" ]] && \
  export PATH="$RUBY_DIR/bin:$PATH"


