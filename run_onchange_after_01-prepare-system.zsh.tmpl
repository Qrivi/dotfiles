#!/usr/bin/env zsh

set -euo pipefail
source {{ joinPath .chezmoi.sourceDir "assets/scripts/helpers.zsh" | quote }}

step "Prepare system"

# Directories my zsh config writes to but does not create if missing
mkdir -p "$HOME/.cache/zsh" "$HOME/.local/state/zsh" "$HOME/.local/share" "$HOME/.local/bin"

# Directory where I do my work
mkdir -p "$HOME/Developer"

{{ if eq .chezmoi.os "darwin" }}
# A sound file with no sound (used in eg BTT where you must specify a sound file for notifications)
mkdir -p "$HOME/Library/Sounds"
[[ -e "$HOME/Library/Sounds/Silent.aiff" ]] || touch "$HOME/Library/Sounds/Silent.aiff"

{{ end }}

success "Done"

{{ if eq .chezmoi.os "darwin" }}

step "Allow apps from anywhere"

# Recent macOS versions reveal the Anywhere option but require GUI confirmation,
# returning a nonzero status even though the request succeeded.
spctl_exit=0
spctl_output="$(sudo spctl --master-disable 2>&1)" || spctl_exit=$?

if [[ "$spctl_output" == *"Globally disabling the assessment system needs to be confirmed in System Settings"* ]]; then
  warning "Confirm Allow applications from: Anywhere in System Settings > Privacy & Security > Security."
  info "Setup will continue; you can confirm this setting afterwards."
elif (( spctl_exit != 0 )); then
  print -u2 -r -- "$spctl_output"
  exit "$spctl_exit"
else
  success "Apps from anywhere are allowed"
fi

step "Enable TouchID for sudo"

readonly PAM_TOUCHID_RULE='auth       sufficient     pam_tid.so'
readonly SUDO_LOCAL='/etc/pam.d/sudo_local'

if sudo grep -Fqx "$PAM_TOUCHID_RULE" "$SUDO_LOCAL" 2>/dev/null; then
  success "TouchID for sudo is already enabled"
else
  printf '%s\n' "$PAM_TOUCHID_RULE" | sudo tee -a "$SUDO_LOCAL" >/dev/null
  success "TouchID for sudo is now enabled"
fi

{{ end }}
