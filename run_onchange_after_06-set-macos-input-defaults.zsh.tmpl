#!/usr/bin/env zsh
{{ if eq .chezmoi.os "darwin" }}

set -euo pipefail
source {{ joinPath .chezmoi.sourceDir "assets/scripts/helpers.zsh" | quote }}

step "Set macOS input defaults"

# Keyboard
defaults write NSGlobalDomain KeyRepeat -int 2 # Repeat held keys quickly.
defaults write NSGlobalDomain InitialKeyRepeat -int 15 # Start repeating a held key after a short delay.
defaults write NSGlobalDomain NSAutomaticCapitalizationEnabled -bool true # Capitalize words automatically.
defaults write NSGlobalDomain NSAutomaticPeriodSubstitutionEnabled -bool true # Insert a period after pressing Space twice.

# Use "ABC - Extended" as the only keyboard layout while keeping the character
# viewer, accent picker, and macOS dictation. A logout may be needed to see it.
defaults write com.apple.HIToolbox AppleEnabledInputSources -array \
  '<dict><key>Bundle ID</key><string>com.apple.CharacterPaletteIM</string><key>InputSourceKind</key><string>Non Keyboard Input Method</string></dict>' \
  '<dict><key>Bundle ID</key><string>com.apple.PressAndHold</string><key>InputSourceKind</key><string>Non Keyboard Input Method</string></dict>' \
  '<dict><key>Bundle ID</key><string>com.apple.inputmethod.ironwood</string><key>InputSourceKind</key><string>Non Keyboard Input Method</string></dict>' \
  '<dict><key>InputSourceKind</key><string>Keyboard Layout</string><key>KeyboardLayout ID</key><integer>-2</integer><key>KeyboardLayout Name</key><string>US Extended</string></dict>'
defaults write com.apple.HIToolbox AppleSelectedInputSources -array \
  '<dict><key>Bundle ID</key><string>com.apple.PressAndHold</string><key>InputSourceKind</key><string>Non Keyboard Input Method</string></dict>' \
  '<dict><key>InputSourceKind</key><string>Keyboard Layout</string><key>KeyboardLayout ID</key><integer>-2</integer><key>KeyboardLayout Name</key><string>US Extended</string></dict>'
defaults write com.apple.HIToolbox AppleInputSourceHistory -array \
  '<dict><key>InputSourceKind</key><string>Keyboard Layout</string><key>KeyboardLayout ID</key><integer>-2</integer><key>KeyboardLayout Name</key><string>US Extended</string></dict>'
defaults write com.apple.HIToolbox AppleCurrentKeyboardLayoutInputSourceID -string 'com.apple.keylayout.USExtended'

# Mouse and trackpad behavior
defaults write NSGlobalDomain AppleEnableMouseSwipeNavigateWithScrolls -bool true # Enable swipe navigation with a mouse or trackpad.
defaults write NSGlobalDomain com.apple.mouse.scaling -float 3 # Set mouse tracking speed to the Settings UI maximum.
defaults write NSGlobalDomain com.apple.trackpad.scaling -float 3 # Set trackpad tracking speed to the Settings UI maximum.
defaults write NSGlobalDomain com.apple.trackpad.forceClick -bool true # Enable Force Click and haptic feedback.
defaults -currentHost write NSGlobalDomain com.apple.trackpad.threeFingerHorizSwipeGesture -int 0 # Disable three-finger horizontal swipe gestures.
defaults -currentHost write NSGlobalDomain com.apple.trackpad.threeFingerVertSwipeGesture -int 0 # Disable three-finger vertical swipe gestures.
defaults -currentHost write NSGlobalDomain com.apple.trackpad.fourFingerHorizSwipeGesture -int 2 # Switch desktops and full-screen apps with four fingers.
defaults -currentHost write NSGlobalDomain com.apple.trackpad.fourFingerVertSwipeGesture -int 2 # Use four fingers for Mission Control and App Exposé.

# Apply the same gestures to built-in and Bluetooth trackpads.
for trackpad_domain in \
  com.apple.AppleMultitouchTrackpad \
  com.apple.driver.AppleBluetoothMultitouch.trackpad
do
  defaults write "$trackpad_domain" Clicking -bool false # Require a physical click instead of tap-to-click.
  defaults write "$trackpad_domain" TrackpadRightClick -bool true # Use a two-finger click as secondary click.
  defaults write "$trackpad_domain" TrackpadThreeFingerDrag -bool true # Drag windows and items with three fingers.
  defaults write "$trackpad_domain" TrackpadThreeFingerHorizSwipeGesture -int 0 # Disable three-finger horizontal swipe gestures.
  defaults write "$trackpad_domain" TrackpadThreeFingerVertSwipeGesture -int 0 # Disable three-finger vertical swipe gestures.
  defaults write "$trackpad_domain" TrackpadFourFingerHorizSwipeGesture -int 2 # Swipe between desktops and full-screen apps with four fingers.
  defaults write "$trackpad_domain" TrackpadFourFingerVertSwipeGesture -int 2 # Use four-finger vertical swipes for Mission Control and App Exposé.
  defaults write "$trackpad_domain" TrackpadFourFingerPinchGesture -int 2 # Pinch with four fingers to show Launchpad.
  defaults write "$trackpad_domain" TrackpadFiveFingerPinchGesture -int 2 # Pinch with five fingers to show Launchpad.
  defaults write "$trackpad_domain" TrackpadPinch -bool true # Enable pinch-to-zoom.
  defaults write "$trackpad_domain" TrackpadRotate -bool true # Enable two-finger rotation.
  defaults write "$trackpad_domain" TrackpadTwoFingerDoubleTapGesture -int 1 # Enable two-finger Smart Zoom.
  defaults write "$trackpad_domain" TrackpadTwoFingerFromRightEdgeSwipeGesture -int 3 # Swipe from the right edge to show Notification Center.
done

# Apply the same gestures to Magic Mouse preference domains.
for mouse_domain in \
  com.apple.AppleMultitouchMouse \
  com.apple.driver.AppleBluetoothMultitouch.mouse
do
  defaults write "$mouse_domain" MouseButtonMode -string TwoButton # Enable left and right clicking.
  defaults write "$mouse_domain" MouseHorizontalScroll -bool true # Enable horizontal scrolling.
  defaults write "$mouse_domain" MouseMomentumScroll -bool true # Keep scrolling with momentum after a swipe.
  defaults write "$mouse_domain" MouseOneFingerDoubleTapGesture -int 1 # Enable one-finger Smart Zoom.
  defaults write "$mouse_domain" MouseTwoFingerDoubleTapGesture -int 3 # Open Mission Control with a two-finger double tap.
  defaults write "$mouse_domain" MouseTwoFingerHorizSwipeGesture -int 2 # Swipe between desktops and full-screen apps with two fingers.
  defaults write "$mouse_domain" MouseVerticalScroll -bool true # Enable vertical scrolling.
done

success "Done"
{{ end }}
