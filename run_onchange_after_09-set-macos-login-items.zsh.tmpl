#!/usr/bin/env zsh
{{ if eq .chezmoi.os "darwin" }}

set -euo pipefail
source {{ joinPath .chezmoi.sourceDir "assets/scripts/helpers.zsh" | quote }}

step "Configure macOS login items"

typeset -a login_apps=(
  "/Applications/BetterTouchTool.app"
  "/Applications/Calendr.app"
  "/Applications/Vorssaint.app"
{{- if eq .profile "macos-work" }}
  "/Applications/Beeper Desktop.app"
  "/Applications/BetterDisplay.app"
  "/System/Applications/Mail.app"
  "/Applications/OpenWhispr.app"
{{- end }}
)

# Add only missing entries, preserving other login items and their settings.
# macOS may ask permission for the terminal to control System Events.
for app in "${login_apps[@]}"; do
  if [[ ! -d "$app" ]]; then
    warning "Cannot add ${app:t:r} to login items because it is not installed at $app"
    continue
  fi

  osascript - "$app" <<'APPLESCRIPT'
on run argv
  set appPath to item 1 of argv
  tell application "System Events"
    if not (exists (login items whose path is appPath)) then
      make new login item at end of login items with properties {path:appPath, hidden:false}
    end if
  end tell
end run
APPLESCRIPT
done

success "Login items are configured"
{{ end }}
